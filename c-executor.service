[Unit]
Description=C Code Executor API (Hardened)
After=network.target

[Service]
Type=simple
User=c-executor
Group=c-executor
WorkingDirectory=/var/www/c-executor
ExecStart=/usr/bin/python3 /var/www/c-executor/server.py
Restart=always
RestartSec=5

# Filesystem protection
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/tmp

# Capability restrictions
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN

# Resource limits
MemoryMax=512M
CPUQuota=50%
TasksMax=100

# Network (allow localhost only)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
