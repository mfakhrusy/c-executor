[Unit]
Description=C Code Executor API
After=network.target

[Service]
Type=simple
User=c-executor
Group=c-executor
WorkingDirectory=/var/www/c-executor
ExecStart=/usr/bin/python3 /var/www/c-executor/server.py
Restart=always
RestartSec=5

# Absolutely minimal - no hardening that interferes with firejail
NoNewPrivileges=false

# Resource limits only (safe)
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
