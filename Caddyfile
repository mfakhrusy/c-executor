# Caddyfile for Wasmer SDK with required COEP/COOP headers
#
# Replace "your-domain.com" with your actual domain or use localhost:8080 for testing

your-domain.com {
    root * /var/www/wasmer-test
    file_server

    header {
        # Required for SharedArrayBuffer (Wasmer SDK threading)
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "credentialless"
        
        # Optional but recommended security headers
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}

# For local testing without HTTPS (development only)
# Run: caddy run --config Caddyfile
:8080 {
    root * .
    file_server

    header {
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "credentialless"
    }
}
